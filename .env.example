# === Database ===
ERP_DATASOURCE_URL=jdbc:postgresql://localhost:5432/erp
ERP_DATASOURCE_USERNAME=erp
ERP_DATASOURCE_PASSWORD=erp
ERP_DATASOURCE_DRIVER=org.postgresql.Driver

# === PostgreSQL (Docker) ===
ERP_POSTGRES_PASSWORD=erp

# === Redis ===
ERP_REDIS_HOST=localhost
ERP_REDIS_PORT=6379
ERP_REDIS_PASSWORD=
ERP_REDIS_DATABASE=0

# === Kafka ===
ERP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ERP_KAFKA_TOPIC=erp.domain.events

# === MinIO ===
ERP_MINIO_ENDPOINT=http://localhost:9000
ERP_MINIO_ACCESS_KEY=minioadmin
ERP_MINIO_SECRET_KEY=minioadmin
ERP_MINIO_BUCKET=erp-files

# === Elasticsearch ===
ERP_ES_HOST=localhost
ERP_ES_PORT=9200

# === Nacos ===
NACOS_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789

# === Kong ===
KONG_DB_PASSWORD=kong

# === JWT ===
ERP_JWT_SECRET=change-this-to-a-secure-random-string-at-least-256-bits-long
ERP_JWT_EXPIRATION=7200

# === Sentinel ===
ERP_SENTINEL_FLOW_RATE=100
ERP_SENTINEL_DEGRADE_RT=3000
ERP_SENTINEL_DEGRADE_RATIO=0.5
ERP_SENTINEL_DEGRADE_WINDOW=10
ERP_SENTINEL_SYSTEM_LOAD=-1
ERP_SENTINEL_SYSTEM_CPU_USAGE=0.8
